{
  "name": "agentic-search-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "yarn typecheck && yarn test:build-config && yarn test:unit",
    "test:ci": "yarn lint && yarn format:check && yarn typecheck && yarn build && yarn test:build-config && yarn test:unit",
    "test:build-config": "node --test tests/vite.test.cjs",
    "start:app": "vite",
    "start:mock": "vite --mode mock",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.18",
    "@reduxjs/toolkit": "^2.13.0",
    "lucide-react": "^1.59.0",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-router": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@1.22.22"
}
