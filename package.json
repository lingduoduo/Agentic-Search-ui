{
  "name": "agentic-search-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "tsc -b && webpack --mode production",
    "preview": "serve -s dist -l tcp://127.0.0.1:4173",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "yarn typecheck && yarn test:build-config && yarn test:unit",
    "test:ci": "yarn lint && yarn format:check && yarn typecheck && yarn build && yarn test:build-config && yarn test:unit",
    "test:build-config": "node --test tests/webpack.test.cjs",
    "start:app": "webpack serve --mode development",
    "start:mock": "webpack serve --mode development --env mock",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.18",
    "lucide-react": "^1.59.0",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.21",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.9",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.3",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "prettier": "3.9.10",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "serve": "^14.2.6",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "webpack": "^5",
    "webpack-cli": "^6",
    "webpack-dev-server": "^5"
  },
  "packageManager": "yarn@1.22.22"
}
